# Plantilla de configuracion. Copiar como .env y completar con valores reales:
#   cp .env.example .env
# El archivo .env no se versiona. En produccion, definir estas mismas variables
# como variables de entorno del sistema en lugar de usar un archivo.

# Conexion a PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/gestioneventosdb
DB_USERNAME=cambiar
DB_PASSWORD=cambiar

# Clave de firma JWT (HS512). Minimo 64 caracteres.
# Generar una nueva con: openssl rand -base64 64
JWT_SECRET=cambiar-por-una-clave-generada-de-al-menos-64-caracteres
